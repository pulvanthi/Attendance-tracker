# PostgreSQL Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Fallback SQLite DB path if PostgreSQL is not reachable immediately
SQLITE_FALLBACK_URL=sqlite:///./attendance.db

# JWT Security
SECRET_KEY=change-me  # python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
PROJECT_NAME="Attendance Tracker Pro API"
API_V1_STR="/api"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Shift default start time (for Late calculation)
DEFAULT_SHIFT_START="09:30"

# Initial admin account (created by seed.py if missing)
ADMIN_EMAIL=admin@attendance.pro
ADMIN_PASSWORD=choose-a-strong-password
